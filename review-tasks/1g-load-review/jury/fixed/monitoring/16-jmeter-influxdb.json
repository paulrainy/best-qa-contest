          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nt"
          },
          "query": "SELECT sum(\"count\") FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"statut\" = 'all' AND \"transaction\" =~ /^$transaction$/ AND $timeFilter GROUP BY time($__interval), \"transaction\" fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_transaction"
        }
      ]

{
  "uid": "efr-nt-jmeter",
  "title": "ЕФР НТ — JMeter",
  "tags": [
    "efr",
    "nt",
    "jmeter"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Тест",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-nt"
        },
        "query": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"application\"",
        "refresh": 2,
        "multi": false
      },
      {
        "name": "transaction",
        "label": "Операция",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-nt"
        },
        "query": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"transaction\" WHERE \"application\" =~ /^$application$/",
        "regex": "/^ОП-/",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Активные потоки",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-nt"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nt"
          },
          "query": "SELECT max(\"maxAT\") FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"transaction\" = 'internal' AND $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Потоки"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Интенсивность по операциям",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-nt"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {

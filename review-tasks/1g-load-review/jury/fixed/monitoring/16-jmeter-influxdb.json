        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nt"
          },
          "query": "SELECT sum(\"w\") / sum(\"c\") FROM (SELECT \"avg\" * \"count\" AS \"w\", \"count\" AS \"c\" FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"statut\" = 'ok' AND \"transaction\" =~ /^$transaction$/ AND $timeFilter GROUP BY \"transaction\") WHERE $timeFilter GROUP BY time($__interval), \"transaction\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_transaction"
        }
      ]
